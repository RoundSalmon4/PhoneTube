{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["every weekend"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Disable pinned deps that must not be updated for MediaServiceCore compatibility",
      "matchPackageNames": [
        "com.squareup.okhttp3:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable Kotlin — pinned to 2.2.21 for KSP1 + MediaServiceCore compatibility",
      "matchPackageNames": [
        "org.jetbrains.kotlin:*",
        "org.jetbrains.kotlin.plugin.*"
      ],
      "enabled": false
    },
    {
      "description": "Disable KSP — pinned to KSP1 (ksp.useKSP2=false)",
      "matchPackageNames": [
        "com.google.devtools.ksp:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable AGP — pinned to 8.7.3 until Kotlin 2.3 / AGP 9 bump",
      "matchPackageNames": [
        "com.android.application",
        "com.android.library",
        "com.android.tools.build:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable coroutines — forced to 1.9.0 via root build.gradle.kts resolution strategy",
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-coroutines-*"
      ],
      "enabled": false
    },
    {
      "description": "Disable retrofit — MediaServiceCore transitive dep, must stay at 2.5.0",
      "matchPackageNames": [
        "com.squareup.retrofit2:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable cronet — pinned for min SDK 24 compatibility",
      "matchPackageNames": [
        "org.chromium.net:*",
        "com.google.net.cronet:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable dnsjava — MediaServiceCore transitive dep",
      "matchPackageNames": [
        "dnsjava:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable json-path — MediaServiceCore transitive dep",
      "matchPackageNames": [
        "com.jayway.jsonpath:*"
      ],
      "enabled": false
    },
    {
      "description": "Disable Gradle — stay on 8.x for AGP 8.7.3 compat",
      "matchPackageNames": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "description": "Disable build.yml and build-release.yml from updates",
      "matchFileNames": [
        ".github/workflows/build.yml",
        ".github/workflows/build-release.yml"
      ],
      "enabled": false
    },
    {
      "description": "Group all remaining updates into a single PR",
      "matchPackagePatterns": [".*"],
      "groupName": "all-dependencies",
      "groupSlug": "all-deps"
    }
  ]
}
