{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["every weekend"],
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "git-submodules": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Disable OkHttp — MediaServiceCore compat, pinned at 3.12.13",
      "matchPackageNames": ["com.squareup.okhttp3:*"],
      "enabled": false
    },
    {
      "description": "Disable Kotlin — pinned for KSP1 + MediaServiceCore compat",
      "matchPackageNames": ["org.jetbrains.kotlin*", "org.jetbrains.kotlin.android*"],
      "enabled": false
    },
    {
      "description": "Disable KSP — pinned to KSP1",
      "matchPackageNames": ["com.google.devtools.ksp*"],
      "enabled": false
    },
    {
      "description": "Disable AGP — pinned until Kotlin 2.3 / AGP 9 bump",
      "matchPackageNames": ["com.android.application*", "com.android.library*", "com.android.tools.build*"],
      "enabled": false
    },
    {
      "description": "Disable coroutines — forced via resolution strategy",
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-coroutines*"],
      "enabled": false
    },
    {
      "description": "Disable retrofit — MediaServiceCore transitive dep",
      "matchPackageNames": ["com.squareup.retrofit2*"],
      "enabled": false
    },
    {
      "description": "Disable cronet — pinned for min SDK 24",
      "matchPackageNames": ["org.chromium.net*", "com.google.net.cronet*"],
      "enabled": false
    },
    {
      "description": "Disable dnsjava — MediaServiceCore transitive dep",
      "matchPackageNames": ["dnsjava*"],
      "enabled": false
    },
    {
      "description": "Disable json-path — MediaServiceCore transitive dep",
      "matchPackageNames": ["com.jayway.jsonpath*"],
      "enabled": false
    },
    {
      "description": "Disable Gradle — stay on 8.x for AGP 8.7.3 compat",
      "matchPackageNames": ["gradle"],
      "enabled": false
    },
    {
      "description": "Disable CI workflow files from updates",
      "matchFileNames": [".github/workflows/*"],
      "enabled": false
    },
    {
      "description": "Disable deps requiring compileSdk 36+ or AGP 9.0.0+",
      "matchPackageNames": [
        "com.google.dagger:hilt*",
        "com.google.dagger:dagger*",
        "androidx.room*",
        "androidx.lifecycle*",
        "androidx.navigation*",
        "androidx.hilt*",
        "androidx.activity*",
        "androidx.media3*",
        "androidx.compose*",
        "io.coil-kt.coil3*",
        "androidx.core:core-ktx"
      ],
      "enabled": false
    },
    {
      "description": "Group all remaining updates into a single PR",
      "matchPackagePatterns": [".*"],
      "groupName": "all-dependencies",
      "groupSlug": "all-deps"
    }
  ]
}
